extends layout

block content
  main.waterfall-editor
    if waterfall
      section.waterfall-card
        p.waterfall-eyebrow WATERFALL COLLECTION
        h1= title
        p.waterfall-intro Edit the details below and save your changes.

        p.waterfall-record
          strong Record ID
          span= waterfall._id

        form#updateForm(action='/resource/waterfalls/' + waterfall._id)
          div.waterfall-field
            label(for='name') Name
            input#name(type='text', name='name', value=waterfall.name, required)

          div.waterfall-field
            label(for='country') Country
            input#country(type='text', name='country', value=waterfall.country, required)

          div.waterfall-field
            label(for='height') Height (meters)
            input#height(type='number', name='height', value=waterfall.height, step='any', required)

          div.waterfall-actions
            button.waterfall-save(type='submit') Save changes
            a.waterfall-cancel(href='/waterfalls') Cancel

      script.
        document.getElementById('updateForm').addEventListener('submit', async function(event) {
          event.preventDefault();

          var form = event.currentTarget;
          var button = form.querySelector('button[type="submit"]');
          button.disabled = true;

          try {
            var response = await fetch(form.action, {
              method: 'PUT',
              body: new URLSearchParams(new FormData(form))
            });

            var result = await response.json();

            if (!response.ok) {
              throw new Error(result.error || 'Unable to update waterfall.');
            }

            alert('Waterfall updated successfully.');
          } catch (error) {
            alert(error.message);
          } finally {
            button.disabled = false;
          }
        });
    else
      section.waterfall-card
        p.waterfall-eyebrow WATERFALL COLLECTION
        h1 Waterfall not found
        p.waterfall-intro This waterfall may have been deleted. Return to the collection to select another.
        a.waterfall-cancel(href='/waterfalls') Back to waterfalls