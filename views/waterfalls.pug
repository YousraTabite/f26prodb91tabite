extends layout

block content
  h1= title

  -
    let results = [
      { name: "Ouzoud Falls", country: "Morocco", height: 110 },
      { name: "Angel Falls", country: "Venezuela", height: 979 },
      { name: "Victoria Falls", country: "Zambia and Zimbabwe", height: 108 }
    ];

  div(class="container-fluid")
    div(class="row")
      each item, index in results
         div(class="col-sm-2", onclick="buy(" + index + ")")
          p Name: #{item.name}
          p Country: #{item.country}
          p Height: #{item.height} meters
  script.
    function buy(index) {
      alert("You purchased item " + index + ".");
    }