extends layout

block content
  h1= title

  if waterfall
    div
      span.waterfall-label ID
      span= waterfall._id

    div
      span.waterfall-label Name
      span= waterfall.name

    div
      span.waterfall-label Country
      span= waterfall.country

    div
      span.waterfall-label Height
      span #{waterfall.height} meters
  else
    p This waterfall could not be found. It may have been deleted.

  p
    a(href='/waterfalls') Back to waterfalls